# ==========================================================
# COLUA - CONFIGURACION DE PRODUCCION
# Copia este archivo a .env SOLO para desarrollo.
# En produccion configura estas variables en el hosting.
# NUNCA subas .env al repositorio.
# ==========================================================

# PostgreSQL 16+ con extension pgvector
DATABASE_URL=postgresql://usuario:password@host:5432/colua

# Seguridad
APP_SECRET_KEY=GENERA_UN_VALOR_ALEATORIO_LARGO
DPI_PEPPER=GENERA_OTRO_VALOR_ALEATORIO_LARGO
# En desarrollo local con http://localhost usa false. En producción HTTPS usa true.
COOKIE_SECURE=false
SESSION_HOURS=8
REMEMBER_SESSION_DAYS=30

# Administrador inicial.
# Solo se usa si NO existe el usuario administrador en la BD.
# Después del primer arranque puedes retirar ADMIN_BOOTSTRAP_PASSWORD.
ADMIN_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=COLOCA_UNA_CONTRASENA_TEMPORAL_SEGURA
ADMIN_NAME=Administrador COLUA

# RAG: recuperación semántica siempre en PostgreSQL/pgvector.
# OpenAI se usa para embeddings; el generador puede ser OpenAI o Claude.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RAG_TOP_K=5
RAG_MIN_SCORE=0.28

# Generación principal: openai | anthropic
LLM_PROVIDER=openai
# Fallback opcional en nube: anthropic | openai | none
LLM_FALLBACK_PROVIDER=anthropic
OPENAI_CHAT_MODEL=gpt-5.6-luna
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
MAX_OUTPUT_TOKENS=650

# Servidor
HOST=0.0.0.0
PORT=8000
# Desarrollo local de Colua-Web:
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://colua-info.web.app,https://colua-info.firebaseapp.com

# Integración con COLUA Web / Firebase Authentication
FIREBASE_PROJECT_ID=colua-info
# Agencia inicial para usuarios vinculados desde el portal si aún no poseen una asignada.
PORTAL_DEFAULT_AGENCY_ID=central
# URL pública donde vive este frontend RAG.
PUBLIC_APP_URL=http://127.0.0.1:8000
# Minutos de validez del enlace SSO de un solo uso hacia precalificación.
PORTAL_SSO_MINUTES=5
